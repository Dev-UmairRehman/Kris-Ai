{
  "name": "kris-ai-memory",
  "version": "1.0.0",
  "private": true,
  "description": "Kris AI Memory - members-only chat for StrategyTraining.com, backed by BuddyPro. Clone of the Kris AI page.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "smoke": "node scripts/smoke.js",
    "shots": "node scripts/shots.js",
    "shots:extra": "node scripts/shots-extra.js",
    "probe:audio": "node scripts/probe-audio.js",
    "test:embed": "node scripts/test-embed.js",
    "probe:language": "node scripts/probe-language.js",
    "test:speech": "node scripts/test-speech.js",
    "test:call": "node scripts/test-call.js",
    "make:greeting": "node scripts/make-greeting.js",
    "test:headcode": "node scripts/test-headcode.js",
    "shots:ui": "node scripts/shots-ui.js",
    "test:masterplan": "node --test masterplan/test/costs.test.js masterplan/test/pipeline.test.js masterplan/test/security.test.js",
    "build:masterplan-page": "node scripts/build-masterplan-page.js",
    "seal:masterplan-knowledge": "node scripts/seal-masterplan-knowledge.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "express": "^4.21.2",
    "pdfjs-dist": "^6.4.299",
    "pdfmake": "^0.3.11"
  },
  "devDependencies": {
    "puppeteer-core": "^25.9.0"
  }
}
