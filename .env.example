# ---------------------------------------------------------------------------
# Kris AI - environment
# Copy to .env for local dev. In DigitalOcean set these as App-level secrets.
# NOTHING in this file may ever be shipped to the browser.
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=production

# --- BuddyPro -------------------------------------------------------------
# Generate in Telegram, in your BuddyPro bot:
#   Owner API     ->  /generateApiKey:kris-ai-web        (key starts bapi_)
#   End-user API  ->  /generateClientApiKey:kris-ai-web  (key starts bapi_B2C_)
# The code detects which one you gave it from the prefix.
# READ THE PRIVACY NOTE IN README BEFORE USING AN OWNER KEY FOR REAL MEMBERS.
BUDDYPRO_API_KEY=bapi_replace_me
BUDDYPRO_BASE_URL=https://api.buddypro.ai

# Salt for hashing StrategyTraining member ids into BuddyPro `user` profile ids.
# Set once and NEVER change it - changing it orphans every member's chat memory.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMBER_ID_SALT=replace_me_with_32_random_bytes_hex

# --- Michael AI memory sync (optional) -------------------------------------
# Michael AI posts members' finished work to POST /api/memory with this as the
# Bearer token (same value as KRIS_MEMORY_SECRET in Michael AI). Empty = off.
MEMORY_INGEST_SECRET=

# --- Session signing ------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_32_random_bytes_hex
SESSION_TTL_SECONDS=7200

# --- StrategyTraining / Uscreen ------------------------------------------
STORE_ORIGIN=https://www.strategytraining.com
JOIN_URL=https://www.strategytraining.com/join
SIGN_IN_URL=https://www.strategytraining.com/sign_in

# Extra origins allowed to iframe this app (comma separated). The apex domain
# and the Uscreen preview domain usually need to be here too.
ALLOWED_FRAME_ORIGINS=https://www.strategytraining.com,https://strategytraining.com

# Uscreen API - used to confirm a visitor really is an active subscriber.
# Publisher dashboard > Settings > Integrations > API  (or ask Uscreen support).
USCREEN_API_BASE=https://www.strategytraining.com/api/v1
USCREEN_API_KEY=

# Gate behaviour when Uscreen cannot be reached / is not configured:
#   strict  - deny and send the visitor to JOIN_URL  (correct for production)
#   frame   - trust the frame lock alone: being inside the members-only
#             head-code snippet's signed-in claim is trusted
#   open    - no gate at all. LOCAL DEVELOPMENT ONLY.
MEMBER_GATE_MODE=strict

# --- Rate limiting --------------------------------------------------------
# BuddyPro allows 30 req/min per key. Stay under it.
RATE_GLOBAL_PER_MIN=25
RATE_SESSION_PER_MIN=12

# Voice (Call + microphone). Currently false: this BuddyPro instance does not
# process audio - audio-only requests return 500 "Error processing the message",
# and modalities:["text","audio"] returns 200 with no audio object.
# The client recorder is built and tested. Re-check with `npm run probe:audio`,
# and set this to true once BuddyPro enables audio.
VOICE_ENABLED=true

# Added to the BuddyPro profile's own prompt on every request (Owner API only).
# Without it the profile drifts between languages and opens with a 'rules of
# engagement' introduction. Leave unset to use the built-in default, or set to
# an empty value to send no override at all.
#BUDDYPRO_SYSTEM_PROMPT=

# Reply language. BuddyPro drifts into other languages as a profile ages;
# this pins it. Empty string = let BuddyPro auto-detect.
RESPONSE_LANGUAGE=English


# In frame mode, require the store page to confirm someone is signed in.
# A Uscreen landing page is public, so the iframe alone proves nothing.
REQUIRE_STORE_IDENTITY=true

# ===========================================================================
# MasterPlan Digital - a separate StrategyTraining.com product that shares
# this server. Everything below is used only by ./masterplan (routes under
# /masterplan). It is NOT Michael AI and uses none of Michael AI's services.
# Off until MP_ENABLED=true; a missing setting disables it, never the server.
# ===========================================================================
MP_ENABLED=false

# Claude, through OpenRouter (default when its key is set) or direct from Anthropic.
MP_LLM_PROVIDER=openrouter
MP_OPENROUTER_API_KEY=
# Only for MP_LLM_PROVIDER=anthropic:
MP_ANTHROPIC_API_KEY=
# Defaults: anthropic/claude-opus-5.5 (OpenRouter), claude-opus-5-5 (Anthropic)
MP_MODEL=
# Essay effort (high) and cost-research effort (medium).
MP_EFFORT=high
MP_RESEARCH_EFFORT=medium
MP_MAX_SEARCHES=8

# Storage: supabase in production (records in a Postgres table, files in a
# private Storage bucket; schema in masterplan/sql/001_storage.sql), disk for
# local development. Only the secret key is used, and only on the server.
MP_STORAGE=disk
MP_SUPABASE_URL=https://<project-ref>.supabase.co
MP_SUPABASE_SECRET_KEY=
MP_SUPABASE_BUCKET=masterplan
MP_SUPABASE_TABLE=mp_records
MP_FILE_CACHE_MB=256

# "Your MasterPlan is ready" email: resend in production (the From domain
# must be verified in that Resend account), log for development.
MP_EMAIL_DRIVER=log
MP_RESEND_API_KEY=
MP_EMAIL_FROM=StrategyTraining <no-reply@strategytraining.com>
MP_EMAIL_REPLY_TO=
MP_EMAIL_WEBHOOK_URL=
MP_EMAIL_WEBHOOK_SECRET=
MP_PAGE_URL=https://www.strategytraining.com/pages/masterplan-digital

# Spend guards
MP_PER_MEMBER_PER_DAY=2
MP_GLOBAL_PER_DAY=40
MP_CONCURRENCY=1
MP_WRITE_PARALLEL=5

# PDF footer brand line (the client's wording)
MP_BRAND_LINE=Produced on StrategyTraining.com with Michael AI

# The podcast (third output): a two-host debate, voiced through OpenRouter.
# Needs MP_LLM_PROVIDER=openrouter. About $1.50 per episode on gpt-audio.
MP_PODCAST=true
MP_PODCAST_MODEL=openai/gpt-audio
MP_PODCAST_VOICE_A=ash
MP_PODCAST_VOICE_B=coral
MP_PODCAST_PARALLEL=4
